# ---------------------------------------------------------------
# Instagram Pipeline Dashboard settings. Copy this file to .env.local
# Nothing here is required to try it: set DEMO_MODE=true to see demo data.
# ---------------------------------------------------------------

# Your Google Sheet (paste the full link or just the ID). Leave empty to add
# dashboards from the /admin page instead.
SHEET_ID=

# Name and colour shown on your dashboard
BRAND_NAME=My Business
BRAND_COLOR=#3b82f6
NEXT_PUBLIC_BRAND_NAME=My Business

# Google service account JSON (one line). Share your sheet with its email.
# See README, "Connect your Google Sheet".
GOOGLE_SERVICE_ACCOUNT_KEY=

# Show demo data instead of reading a sheet
# DEMO_MODE=true

# OPTIONAL: lock the dashboard. Leave empty and there is no login at all.
# ACCESS_PASSWORD=

# OPTIONAL (only on Vercel, for saving dashboards added at /admin)
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# OPTIONAL: hide the small "template by" credit
# NEXT_PUBLIC_HIDE_CREDIT=true
